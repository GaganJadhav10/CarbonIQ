# Copy to backend/.env and fill in real values. backend/.env is gitignored.
#
# NEVER put a real password in THIS file -- it is committed to the repository.

# Supabase -> Connect -> Session pooler (port 5432), with the scheme changed
# from postgresql:// to postgresql+psycopg2:// so SQLAlchemy picks the driver.
# The session pooler is required: the direct connection is IPv6-only on the
# free tier and unreachable from Render.
#
# Any reserved character in the password must be percent-encoded, because the
# whole value is a URI: @ -> %40, : -> %3A, / -> %2F, # -> %23, ? -> %3F.
DATABASE_URL=postgresql+psycopg2://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

# Optional -- these have working defaults.
JWT_EXPIRE_MINUTES=60

# The deployed frontend's origin, for CORS. Locally this is the Vite dev server.
# On Render, set it to your https://<project>.vercel.app URL.
FRONTEND_ORIGIN=http://localhost:5173

# Optional regex allowing Vercel preview deployments through CORS. Each branch
# gets a randomly-named *.vercel.app subdomain, so preview URLs cannot be
# enumerated ahead of time. Scope it to your project name, not all of vercel.app.
# Example: ^https://carboniq-[a-z0-9-]+\.vercel\.app$
VERCEL_PREVIEW_ORIGIN_REGEX=
