# Copy to frontend/.env.local and fill in real values. .env.local is gitignored.
#
# IMPORTANT: Vite inlines VITE_* variables into the bundle at BUILD time. They
# are not read at runtime. Changing either of these on Vercel therefore requires
# a redeploy, not just saving the new value.

# Mapbox public access token (starts with pk.). Required for the map to render
# at all -- Mapbox GL JS refuses to initialise without one.
#
# This token is inlined into the public bundle by design. Before submitting,
# restrict it by URL in the Mapbox dashboard to your Vercel domain.
VITE_MAPBOX_TOKEN=pk.your-token-here

# Base URL of the FastAPI backend. Locally this is the uvicorn dev server;
# on Vercel, set it to your https://<service>.onrender.com URL (no trailing slash).
VITE_API_BASE_URL=http://localhost:8000
